SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_POOL=
PAPERCLIP_WEBHOOK_PORT=3100
PAPERCLIP_WEBHOOK_SECRET=
PAPERCLIP_API_URL=http://127.0.0.1:3000
PAPERCLIP_API_KEY=
# Twiglit (https://app.twigl.it). Two surfaces, each activates independently.
TWIGLIT_BASE_URL=https://app.twigl.it
# Twig surface (assigned-twig work): a twg_ API key + WHICH twigs to pick up.
# Set a project id (drop a twig into that project => NanoClaw does it) and/or an
# assignee id. At least one is required to enable the twig surface.
TWIGLIT_API_KEY=
TWIGLIT_WATCH_PROJECT_ID=
TWIGLIT_WATCH_ASSIGNEE_ID=
# Chat surface (WhatsApp-style chat): a Twiglit session token. Optionally an
# ai_connection id to reply AS a bot identity (else replies post as the session user).
TWIGLIT_SESSION_TOKEN=
TWIGLIT_AI_CONNECTION_ID=
# Optional: comma-separated chat_twig_ids to watch (empty = all active chats).
TWIGLIT_CHAT_IDS=
TWIGLIT_POLL_INTERVAL_MS=5000
ASSISTANT_HAS_OWN_NUMBER=
